rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    // 닉네임을 등록했고, 그 닉네임을 지금 이 기기가 쓰고 있는지
    function isMember() {
      return signedIn() && exists(me())
        && get(/databases/$(database)/documents/nicknames/$(get(me()).data.key)).data.uid == request.auth.uid;
    }
    function myKey() { return get(me()).data.key; }
    function ownsNick(key) {
      return signedIn() && get(/databases/$(database)/documents/nicknames/$(key)).data.uid == request.auth.uid;
    }

    // 닉네임 → 지금 이 닉네임을 쓰는 기기(uid)
    match /nicknames/{key} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 12
        && getAfter(/databases/$(database)/documents/pins/$(key)).data.claimBy == request.auth.uid;
      // 다른 기기에서 이어서 쓰기: 같은 배치에서 PIN 확인(pins 갱신)을 통과해야 한다
      allow update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nickname == resource.data.nickname
        && getAfter(/databases/$(database)/documents/pins/$(key)).data.claimBy == request.auth.uid;
      allow delete: if false;
    }

    // PIN 해시: 아무도 읽을 수 없고, 같은 해시를 보낼 때만 갱신된다
    match /pins/{key} {
      allow read: if false;
      allow create: if signedIn()
        && request.resource.data.claimBy == request.auth.uid
        && request.resource.data.pinHash is string
        && !exists(/databases/$(database)/documents/nicknames/$(key))
        && getAfter(/databases/$(database)/documents/nicknames/$(key)).data.uid == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.pinHash == resource.data.pinHash
        && request.resource.data.claimBy == request.auth.uid;
      allow delete: if false;
    }

    // 기기(uid) → 닉네임
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && ownsNickAfter(request.resource.data.key);
      function ownsNickAfter(key) {
        return getAfter(/databases/$(database)/documents/nicknames/$(key)).data.uid == request.auth.uid;
      }
    }

    // 짝선짝후
    match /pairs/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.senior is string && request.resource.data.senior.size() <= 10
        && request.resource.data.junior is string && request.resource.data.junior.size() <= 10;
      allow update, delete: if false;
    }

    // 활동 기록: 학회원 누구나 남기고, 지우는 건 남긴 사람만
    match /activities/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.by == myKey()
        && request.resource.data.type in ['meal', 'cafe', 'study', 'club', 'etc']
        && exists(/databases/$(database)/documents/pairs/$(request.resource.data.pairId));
      allow delete: if isMember() && resource.data.by == myKey();
      allow update: if false;
    }

    // 수박 게임: 한 사람당 문서 하나(id = 닉네임 키), 최고 기록은 줄어들 수 없다
    match /scores/{key} {
      allow read: if isMember();
      allow create: if ownsNick(key)
        && request.resource.data.best is int && request.resource.data.best >= 0 && request.resource.data.best <= 200;
      allow update: if ownsNick(key)
        && request.resource.data.best is int && request.resource.data.best <= 200
        && request.resource.data.best >= resource.data.best;
      allow delete: if false;
    }

    // AI 요약 캐시
    match /summaries/{id} {
      allow read: if isMember();
      allow write: if isMember() && request.resource.data.text is string && request.resource.data.text.size() < 20000;
    }
  }
}
